<Window x:Class="Clearcut.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:Clearcut"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    Title="Clearcut" Icon="Assets/Clearcut.ico"
    Width="1240" Height="800" MinWidth="880" MinHeight="600" WindowStartupLocation="CenterScreen" WindowStyle="None"
    FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="13" Foreground="#EDEDED" Background="#0C0C0C"
    UseLayoutRounding="True" SnapsToDevicePixels="True" AllowDrop="True" TextOptions.TextFormattingMode="Display"
    PreviewKeyDown="OnKeyDown" DragOver="OnDragOver" Drop="OnDrop" Closing="OnClosing">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="52" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="30"/>
        </Grid.RowDefinitions>

        <!-- Header: brand, file actions, document title, export and window buttons -->
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                <Image Source="Assets/Clearcut.ico" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="Clearcut" FontSize="14" FontWeight="Bold" Margin="9,0,0,1" VerticalAlignment="Center"/>
                <Border Style="{StaticResource Divider}" Margin="16,0,10,0"/>
                <StackPanel Orientation="Horizontal" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="OpenButton" Style="{StaticResource Quiet}" Click="OnOpen" ToolTip="Open image (Ctrl+O)" AutomationProperties.Name="Open image">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource ActionIcon}" Data="M2 6 V4 H8 L10 6 H20 V17 H2 Z M2 9 H20" Margin="0,0,8,0"/>
                            <AccessText Text="_Open"/>
                        </StackPanel>
                    </Button>
                    <Button x:Name="UndoButton" Style="{StaticResource Quiet}" Click="OnUndo" ToolTip="Undo (Ctrl+Z)" AutomationProperties.Name="Undo" Margin="2,0,0,0">
                        <Path Style="{StaticResource ActionIcon}" Data="M8 4 L3 9 L8 14 M3 9 H13 C17 9 19 11 19 15 V17"/>
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource Quiet}" Click="OnRedo" ToolTip="Redo (Ctrl+Y)" AutomationProperties.Name="Redo">
                        <Path Style="{StaticResource ActionIcon}" Data="M14 4 L19 9 L14 14 M19 9 H9 C5 9 3 11 3 15 V17"/>
                    </Button>
                </StackPanel>
            </StackPanel>

            <TextBlock x:Name="FileLabel" Grid.Column="1" Text="No image" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource Muted}" FontWeight="SemiBold" Margin="16,0" TextTrimming="CharacterEllipsis"/>

            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,10,0"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="OriginalButton" Click="OnOriginal" Style="{StaticResource Quiet}" ToolTip="Compare with the original (V)" Margin="0,0,6,0">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ActionIcon}" Margin="0,0,7,0"
                              Data="M1 10 C4 4 16 4 19 10 C16 16 4 16 1 10 Z M10 7 A3 3 0 1 1 10 13 A3 3 0 1 1 10 7 Z"/>
                        <TextBlock x:Name="OriginalLabel" Text="Compare"/>
                    </StackPanel>
                </Button>
                <Button x:Name="ExportButton" Style="{StaticResource Primary}" Click="OnExport"
                        ToolTip="Export PNG (Ctrl+S)" AutomationProperties.Name="Export PNG" Padding="14,6">
                    <StackPanel Orientation="Horizontal">
                        <Path Style="{StaticResource ActionIcon}" Data="M10 2 V13 M6 9 L10 13 L14 9 M3 14 V18 H17 V14" Margin="0,0,8,0"/>
                        <AccessText Text="_Export PNG"/>
                    </StackPanel>
                </Button>
            </StackPanel>

            <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Top" Height="40"
                        shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Click="OnMinimize" ToolTip="Minimize" AutomationProperties.Name="Minimize">
                    <Path Style="{StaticResource CaptionGlyph}" Data="M0 5 H10" Height="1"/>
                </Button>
                <Button Click="OnToggleMaximize">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource CaptionButton}">
                            <Setter Property="ToolTip" Value="Maximize"/>
                            <Setter Property="AutomationProperties.Name" Value="Maximize"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                    <Setter Property="ToolTip" Value="Restore"/>
                                    <Setter Property="AutomationProperties.Name" Value="Restore"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <Path>
                        <Path.Style>
                            <Style TargetType="Path" BasedOn="{StaticResource CaptionGlyph}">
                                <Setter Property="Data" Value="M0.5 0.5 H9.5 V9.5 H0.5 Z"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding WindowState, RelativeSource={RelativeSource AncestorType=Window}}" Value="Maximized">
                                        <Setter Property="Data" Value="M0.5 2.5 H7.5 V9.5 H0.5 Z M2.5 2.5 V0.5 H9.5 V7.5 H7.5"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Path.Style>
                    </Path>
                </Button>
                <Button Style="{StaticResource CaptionButton}" Click="OnClose" Tag="Close" ToolTip="Close" AutomationProperties.Name="Close">
                    <Path Style="{StaticResource CaptionGlyph}" Data="M0 0 L10 10 M10 0 L0 10"/>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Workspace -->
        <Grid Grid.Row="1" Margin="12,0,12,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="300"/>
            </Grid.ColumnDefinitions>

            <!-- Canvas card -->
            <Border CornerRadius="16" Background="#101010" BorderBrush="{StaticResource Line}" BorderThickness="1">
                <Grid>
                    <local:EditorCanvas x:Name="Canvas" Focusable="True" Margin="1" AutomationProperties.Name="Image editing canvas"
                       AutomationProperties.HelpText="Arrow keys move the editing point. Space applies the current brush or sets a crop corner."
                       MouseDown="OnCanvasDown" MouseMove="OnCanvasMove" MouseUp="OnCanvasUp" MouseLeave="OnCanvasLeave"
                       LostMouseCapture="OnCanvasLostCapture" MouseWheel="OnCanvasWheel"/>

                    <Border x:Name="EmptyState" CornerRadius="16">
                        <Border.Background>
                            <DrawingBrush TileMode="Tile" Viewport="0,0,24,24" ViewportUnits="Absolute"
                                          Viewbox="0,0,24,24" ViewboxUnits="Absolute">
                                <DrawingBrush.Drawing>
                                    <DrawingGroup>
                                        <GeometryDrawing Brush="#101010" Geometry="M0,0 H24 V24 H0 Z"/>
                                        <GeometryDrawing Brush="#2B2B2B">
                                            <GeometryDrawing.Geometry>
                                                <EllipseGeometry Center="12,12" RadiusX=".8" RadiusY=".8"/>
                                            </GeometryDrawing.Geometry>
                                        </GeometryDrawing>
                                    </DrawingGroup>
                                </DrawingBrush.Drawing>
                            </DrawingBrush>
                        </Border.Background>
                        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="380" Padding="32,34"
                                Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="20">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="40" ShadowDepth="10" Direction="270" Opacity=".45" Color="Black"/>
                            </Border.Effect>
                            <StackPanel HorizontalAlignment="Center">
                                <Border Width="64" Height="64" CornerRadius="18" Background="{StaticResource AccentFill}" HorizontalAlignment="Center" Margin="0,0,0,20">
                                    <Path Data="M1 7 V1 H7 M24 1 H30 V7 M30 24 V30 H24 M7 30 H1 V24 M7 23 L12 16 L16 21 L21 13 L25 23 Z M10 10 A2 2 0 1 1 10 14 A2 2 0 1 1 10 10 Z"
                                          Stroke="{StaticResource AccentInk}" StrokeThickness="1.8" StrokeLineJoin="Round"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="Drop an image to begin" FontSize="22" FontWeight="SemiBold" TextAlignment="Center"/>
                                <TextBlock Text="Remove backgrounds offline in one click, then refine the edges by hand."
                                           Foreground="{StaticResource Muted}" TextAlignment="Center" TextWrapping="Wrap" LineHeight="19" Margin="0,8,0,22"/>
                                <Button Style="{StaticResource Primary}" Click="OnOpen" HorizontalAlignment="Center" MinWidth="150" MinHeight="40" Padding="18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Style="{StaticResource ActionIcon}" Data="M10 3 V17 M3 10 H17" Margin="0,0,8,0"/>
                                        <TextBlock Text="Choose image"/>
                                    </StackPanel>
                                </Button>
                                <TextBlock Text="PNG · JPG · BMP · TIFF · GIF" Style="{StaticResource SmallText}" Foreground="{StaticResource Faint}"
                                           TextAlignment="Center" Margin="0,16,0,0"/>
                            </StackPanel>
                        </Border>
                    </Border>

                    <!-- Busy indicator -->
                    <ProgressBar x:Name="Progress" Height="3" VerticalAlignment="Top" Margin="16,1,16,0" MinHeight="0"
                                 IsIndeterminate="True" Visibility="Collapsed" IsHitTestVisible="False" Foreground="{StaticResource Accent}"/>

                    <!-- Floating view controls -->
                    <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,16" Padding="5"
                            Background="#E61A1A1A" BorderBrush="{StaticResource LineStrong}" BorderThickness="1" CornerRadius="13">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Visibility, ElementName=EmptyState}" Value="Visible">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <Border.Effect>
                            <DropShadowEffect BlurRadius="24" ShadowDepth="6" Direction="270" Opacity=".5" Color="Black"/>
                        </Border.Effect>
                        <StackPanel x:Name="ViewBar" Orientation="Horizontal">
                            <Button Click="OnZoomOut" Style="{StaticResource Pill}" ToolTip="Zoom out" AutomationProperties.Name="Zoom out">
                                <Path Style="{StaticResource ActionIcon}" Width="12" Height="12" Data="M2 8 H14"/>
                            </Button>
                            <TextBlock x:Name="ZoomLabel" Text="100%" Width="50" VerticalAlignment="Center" TextAlignment="Center"
                                       FontWeight="SemiBold" Foreground="{StaticResource Body}"/>
                            <Button Click="OnZoomIn" Style="{StaticResource Pill}" ToolTip="Zoom in" AutomationProperties.Name="Zoom in">
                                <Path Style="{StaticResource ActionIcon}" Width="12" Height="12" Data="M2 8 H14 M8 2 V14"/>
                            </Button>
                            <Border Style="{StaticResource Divider}"/>
                            <Button Click="OnFit" Style="{StaticResource Pill}" ToolTip="Fit image to canvas (0)" AutomationProperties.Name="Fit to canvas">
                                <StackPanel Orientation="Horizontal">
                                    <Path Style="{StaticResource ActionIcon}" Width="13" Height="13" Margin="0,0,6,0"
                                          Data="M1 5 V1 H5 M11 1 H15 V5 M15 11 V15 H11 M5 15 H1 V11"/>
                                    <TextBlock Text="Fit"/>
                                </StackPanel>
                            </Button>
                            <Border Style="{StaticResource Divider}"/>
                            <Grid>
                                <Button x:Name="BackdropButton" Click="OnBackdrop" Style="{StaticResource Pill}"
                                        ToolTip="Transparency preview background (B)" AutomationProperties.Name="Preview background">
                                    <StackPanel Orientation="Horizontal">
                                        <Border x:Name="BackdropSwatch" Width="14" Height="14" CornerRadius="4" Background="{StaticResource SwatchLightChecker}"
                                                BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,7,0"/>
                                        <TextBlock x:Name="BackdropLabel" Text="Light checker"/>
                                        <Path Style="{StaticResource ActionIcon}" Width="9" Height="9" Margin="7,1,0,0" Data="M1 6 L5 2 L9 6"/>
                                    </StackPanel>
                                </Button>
                                <Popup x:Name="BackdropMenu" PlacementTarget="{Binding ElementName=BackdropButton}" Placement="Top"
                                       VerticalOffset="2" StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                    <Border Margin="12" Padding="6" Background="{StaticResource Panel}" BorderBrush="{StaticResource LineStrong}"
                                            BorderThickness="1" CornerRadius="13" MinWidth="200">
                                        <Border.Effect>
                                            <DropShadowEffect BlurRadius="20" ShadowDepth="6" Direction="270" Opacity=".55" Color="Black"/>
                                        </Border.Effect>
                                        <StackPanel>
                                            <TextBlock Text="PREVIEW BACKGROUND" Style="{StaticResource SectionLabel}" Margin="8,4,0,6"/>
                                            <RadioButton x:Name="LightCheckerChoice" AutomationProperties.Name="Light checker" Tag="0" GroupName="Backdrop" Style="{StaticResource MenuChoice}"
                                                         Checked="OnBackdropChosen" IsChecked="True">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource SwatchLightChecker}"
                                                            BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Light checker" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="DarkCheckerChoice" AutomationProperties.Name="Dark checker" Tag="1" GroupName="Backdrop" Style="{StaticResource MenuChoice}"
                                                         Checked="OnBackdropChosen">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource SwatchDarkChecker}"
                                                            BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Dark checker" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="BlackChoice" AutomationProperties.Name="Solid black" Tag="2" GroupName="Backdrop" Style="{StaticResource MenuChoice}"
                                                         Checked="OnBackdropChosen">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource SwatchBlack}"
                                                            BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Solid black" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton x:Name="WhiteChoice" AutomationProperties.Name="Solid white" Tag="3" GroupName="Backdrop" Style="{StaticResource MenuChoice}"
                                                         Checked="OnBackdropChosen">
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="18" Height="18" CornerRadius="5" Background="{StaticResource SwatchWhite}"
                                                            BorderBrush="#40FFFFFF" BorderThickness="1" Margin="0,0,10,0"/>
                                                    <TextBlock Text="Solid white" VerticalAlignment="Center"/>
                                                </StackPanel>
                                            </RadioButton>
                                        </StackPanel>
                                    </Border>
                                </Popup>
                            </Grid>
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- Sidebar -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="16">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="ToolsPanel" Margin="16,18,16,16">
                        <TextBlock Text="REMOVE BACKGROUND" Style="{StaticResource SectionLabel}"/>
                        <UniformGrid Columns="2" Margin="-4,0">
                            <Button Style="{StaticResource Primary}" Click="OnAutoPhoto" MinHeight="64" Margin="4,0" Padding="8"
                                    ToolTip="Remove the background from a photo (A)" AutomationProperties.Name="Remove photo background">
                                <StackPanel>
                                    <Path Style="{StaticResource ActionIcon}" Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,6"
                                          Data="M2 3 H18 V17 H2 Z M2 14 L7 9 L11 13 L14 10 L18 14 M13 7 H14"/>
                                    <TextBlock Text="Photo" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                            <Button Style="{StaticResource Primary}" Click="OnAutoAnime" MinHeight="64" Margin="4,0" Padding="8"
                                    ToolTip="Remove the background from anime or illustrations (Shift+A)" AutomationProperties.Name="Remove anime background">
                                <StackPanel>
                                    <Path Style="{StaticResource ActionIcon}" Width="18" Height="18" HorizontalAlignment="Center" Margin="0,0,0,6"
                                          Data="M9 2 L11 7 L16 9 L11 11 L9 16 L7 11 L2 9 L7 7 Z M16 2 V6 M14 4 H18 M16 13 V17 M14 15 H18"/>
                                    <TextBlock Text="Anime" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </UniformGrid>
                        <TextBlock Text="Runs offline on your CPU" Style="{StaticResource SmallText}" Foreground="{StaticResource Faint}"
                                   FontSize="11" Margin="2,8,0,0"/>

                        <TextBlock Text="REFINE" Style="{StaticResource SectionLabel}" Margin="2,22,0,8"/>
                        <UniformGrid Columns="3" Margin="-3,0">
                            <RadioButton x:Name="EraseChoice" Tag="Erase" GroupName="Tools" Style="{StaticResource ToolChoice}"
                                         Margin="3" Checked="OnToolChanged" ToolTip="Manual erase (E)" AutomationProperties.Name="Erase">
                                <StackPanel>
                                    <Path Style="{StaticResource ToolIcon}" Data="M3 12 L10 3 Q11 2 12 3 L18 8 Q19 9 18 10 L12 17 H7 Z M7 8 L14 14 M12 17 H19"/>
                                    <TextBlock Text="Erase" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="RepairChoice" Tag="Repair" GroupName="Tools" Style="{StaticResource ToolChoice}"
                                         Margin="3" Checked="OnToolChanged" ToolTip="Restore pixels (R)" AutomationProperties.Name="Repair">
                                <StackPanel>
                                    <Path Style="{StaticResource ToolIcon}" Data="M9 2 L16 5 V9 C16 13 13 16 9 18 C5 16 2 13 2 9 V5 Z M9 7 V13 M6 10 H12"/>
                                    <TextBlock Text="Repair" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="MagicChoice" Tag="Magic" GroupName="Tools" Style="{StaticResource ToolChoice}"
                                         Margin="3" Checked="OnToolChanged" ToolTip="Edge-aware eraser (M)" AutomationProperties.Name="Magic">
                                <StackPanel>
                                    <Path Style="{StaticResource ToolIcon}" Data="M3 15 L13 5 L16 8 L6 18 Z M10 8 L13 11 M4 2 V7 M1.5 4.5 H6.5 M17 2 V5 M15.5 3.5 H18.5"/>
                                    <TextBlock Text="Magic" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="ColorChoice" Tag="Color" GroupName="Tools" Style="{StaticResource ToolChoice}"
                                         Margin="3" Checked="OnToolChanged" ToolTip="Erase a connected color region (G)" AutomationProperties.Name="Auto Color">
                                <StackPanel>
                                    <Path Style="{StaticResource ToolIcon}" Data="M12 6 L15 3 Q16 2 17 3 L18 4 Q19 5 18 6 L15 9 M10 5 L16 11 M11 7 L4 14 L3 18 L7 17 L14 10"/>
                                    <TextBlock Text="Auto Color" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="CropChoice" Tag="Crop" GroupName="Tools" Style="{StaticResource ToolChoice}"
                                         Margin="3" Checked="OnToolChanged" ToolTip="Crop image (C)" AutomationProperties.Name="Crop">
                                <StackPanel>
                                    <Path Style="{StaticResource ToolIcon}" Data="M6 2 V14 H18 M2 6 H14 V18"/>
                                    <TextBlock Text="Crop" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SmoothChoice" Tag="Smooth" GroupName="Tools" Style="{StaticResource ToolChoice}"
                                         Margin="3" Checked="OnToolChanged" ToolTip="Smooth mask edges (S)" AutomationProperties.Name="Smooth">
                                <StackPanel>
                                    <Path Style="{StaticResource ToolIcon}" Data="M2 14 C6 14 6 5 10 5 C14 5 14 14 18 14 M2 17 H18"/>
                                    <TextBlock Text="Smooth" HorizontalAlignment="Center"/>
                                </StackPanel>
                            </RadioButton>
                        </UniformGrid>

                        <Border Background="{StaticResource Surface}" CornerRadius="12" Padding="14" Margin="0,12,0,0">
                            <StackPanel>
                                <TextBlock x:Name="ToolTitle" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,4"/>
                                <TextBlock x:Name="ToolHelp" Style="{StaticResource SmallText}" TextWrapping="Wrap" LineHeight="18" LineStackingStrategy="BlockLineHeight"/>
                                <StackPanel x:Name="SizeGroup" Margin="0,14,0,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="6" Padding="7,2">
                                            <TextBlock x:Name="SizeValue" Style="{StaticResource SmallText}" Foreground="{StaticResource Body}"/>
                                        </Border>
                                        <TextBlock x:Name="SizeLabel" Text="Brush size" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Slider x:Name="SizeSlider" Minimum="2" Maximum="400" Value="36" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,6,0,0" ValueChanged="OnSettingChanged" AutomationProperties.LabeledBy="{Binding ElementName=SizeLabel}"/>
                                </StackPanel>
                                <StackPanel x:Name="ToleranceGroup" Margin="0,10,0,0">
                                    <DockPanel>
                                        <Border DockPanel.Dock="Right" Background="{StaticResource Panel}" CornerRadius="6" Padding="7,2">
                                            <TextBlock x:Name="ToleranceValue" Style="{StaticResource SmallText}" Foreground="{StaticResource Body}"/>
                                        </Border>
                                        <TextBlock x:Name="ToleranceLabel" Text="Tolerance" Style="{StaticResource SmallText}" VerticalAlignment="Center"/>
                                    </DockPanel>
                                    <Slider x:Name="ToleranceSlider" Minimum="0" Maximum="100" Value="22" TickFrequency="1" IsSnapToTickEnabled="True"
                                        Margin="0,6,0,0" ValueChanged="OnSettingChanged" AutomationProperties.LabeledBy="{Binding ElementName=ToleranceLabel}"/>
                                </StackPanel>
                                <Button x:Name="ApplyButton" Click="OnApply" HorizontalAlignment="Stretch" Margin="0,14,0,0" Background="{StaticResource SurfaceHover}"/>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="SHORTCUTS" Style="{StaticResource SectionLabel}" Margin="2,22,0,8"/>
                        <Grid TextBlock.FontSize="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>
                            <TextBlock Text="Zoom" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                            <TextBlock Grid.Column="1" Text="Scroll" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Row="1" Text="Pan" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="Right-drag" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Row="2" Text="Compare original" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="V" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Row="3" Text="Fit to canvas" Foreground="{StaticResource Muted}" Margin="2,0,0,6"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="0" Foreground="{StaticResource Faint}"/>
                            <TextBlock Grid.Row="4" Text="Preview background" Foreground="{StaticResource Muted}" Margin="2,0,0,0"/>
                            <TextBlock Grid.Row="4" Grid.Column="1" Text="B" Foreground="{StaticResource Faint}"/>
                        </Grid>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Status bar -->
        <DockPanel Grid.Row="2" Margin="20,0">
            <TextBlock x:Name="SizeInfo" DockPanel.Dock="Right" VerticalAlignment="Center" Style="{StaticResource SmallText}" Margin="12,0,0,0"/>
            <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#C8F135" VerticalAlignment="Center" Margin="0,0,8,0"/>
            <TextBlock x:Name="Status" Text="Open an image to get started" VerticalAlignment="Center" Style="{StaticResource SmallText}" TextTrimming="CharacterEllipsis"
                       AutomationProperties.LiveSetting="Polite"/>
        </DockPanel>
        <!-- Dims the app while an in-app dialog is open -->
        <Border x:Name="Scrim" Grid.RowSpan="3" Background="#A6000000" Visibility="Collapsed"/>
    </Grid>
</Window>
